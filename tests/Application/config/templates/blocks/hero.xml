<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>hero</key>

    <meta>
        <title lang="en">Hero</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta><title lang="en">Title</title></meta>
        </property>
        <property name="intro" type="text_area">
            <meta><title lang="en">Intro</title></meta>
        </property>
        <property name="image" type="single_media_selection">
            <meta><title lang="en">Image</title></meta>
        </property>
        <property name="button" type="link">
            <meta><title lang="en">Button</title></meta>
        </property>
        <property name="background" type="single_select">
            <meta><title lang="en">Background</title></meta>
            <params>
                <param name="values" type="collection">
                    <param name="light"><meta><title lang="en">Light</title></meta></param>
                    <param name="dark"><meta><title lang="en">Dark</title></meta></param>
                </param>
            </params>
        </property>
    </properties>
</template>
