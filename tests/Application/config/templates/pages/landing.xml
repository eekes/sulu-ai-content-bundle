<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>landing</key>

    <view>pages/default</view>
    <controller>Sulu\Content\UserInterface\Controller\Website\ContentController::indexAction</controller>
    <cacheLifetime>604800</cacheLifetime>

    <meta>
        <title lang="en">Landing page</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta><title lang="en">Title</title></meta>
            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="route" mandatory="true">
            <meta><title lang="en">URL</title></meta>
            <tag name="sulu.rlp"/>
        </property>

        <property name="intro" type="text_area">
            <meta><title lang="en">Intro</title></meta>
        </property>

        <property name="icon" type="single_icon_selection">
            <meta><title lang="en">Icon</title></meta>
            <params>
                <param name="icon_set" value="test"/>
            </params>
        </property>

        <property name="overview" type="smart_content">
            <meta><title lang="en">Overview</title></meta>
            <params>
                <param name="provider" value="pages"/>
                <param name="present_as" type="collection">
                    <param name="cards"><meta><title lang="en">Cards</title></meta></param>
                    <param name="list"><meta><title lang="en">List</title></meta></param>
                </param>
            </params>
        </property>
    </properties>
</template>
