{
    "name": "eekes/sulu-ai-content-bundle",
    "type": "symfony-bundle",
    "description": "An AI writing assistant for Sulu 3: create and rework pages from your own blocks, with brand context per webspace, any model through Symfony AI and a full usage log",
    "keywords": [
        "sulu",
        "sulu-bundle",
        "symfony",
        "ai",
        "llm",
        "content",
        "symfony-ai"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ewald Vanderveken",
            "email": "vandervekenewald@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^2.17 || ^3.3",
        "psr/log": "^3.0",
        "sulu/sulu": "~3.0",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-platform": "^1.0@beta",
        "symfony/clock": "^7.4",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/messenger": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/translation-contracts": "^3.5",
        "symfony/uid": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "cmsig/seal-memory-adapter": "^0.12",
        "php-cs-fixer/shim": "^3.58",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/error-handler": "^7.4.17",
        "symfony/monolog-bundle": "^3.10 || ^4.0",
        "symfony/phpunit-bridge": "^7.4"
    },
    "conflict": {
        "friendsofsymfony/http-cache-bundle": "<3.0.1"
    },
    "autoload": {
        "psr-4": {
            "Eekes\\Sulu\\AiContentBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eekes\\Sulu\\AiContentBundle\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Application/var/"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "support": {
        "issues": "https://github.com/eekes/sulu-ai-content-bundle/issues",
        "source": "https://github.com/eekes/sulu-ai-content-bundle"
    },
    "suggest": {
        "symfony/ai-bundle": "To configure the AI platform and its API key in config/packages/ai.yaml",
        "symfony/ai-anthropic-platform": "For Claude models",
        "symfony/ai-open-ai-platform": "For OpenAI models"
    }
}
